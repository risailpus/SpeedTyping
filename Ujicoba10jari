                { key: '[', label: '[', finger: 'pinky-r' },
                { key: ']', label: ']', finger: 'pinky-r' },
                { key: '\\', label: '\\', finger: 'pinky-r', width: 'w-10 sm:w-12' }
            ],
            [
                { key: 'CapsLock', label: 'Caps', finger: 'pinky-l', width: 'w-14 sm:w-16' },
                { key: 'a', label: 'A', finger: 'pinky-l' },
                { key: 's', label: 'S', finger: 'ring-l' },
                { key: 'd', label: 'D', finger: 'middle-l' },
                { key: 'f', label: 'F', finger: 'index-l', bump: true },
                { key: 'g', label: 'G', finger: 'index-l' },
                { key: 'h', label: 'H', finger: 'index-r' },
                { key: 'j', label: 'J', finger: 'index-r', bump: true },
                { key: 'k', label: 'K', finger: 'middle-r' },
                { key: 'l', label: 'L', finger: 'ring-r' },
                { key: ';', label: ';', finger: 'pinky-r' },
                { key: "'", label: "'", finger: 'pinky-r' },
                { key: 'Enter', label: 'Enter', finger: 'pinky-r', width: 'w-14 sm:w-20' }
            ],
            [
                { key: 'ShiftLeft', label: 'Shift', finger: 'pinky-l', width: 'w-16 sm:w-24' },
                { key: 'z', label: 'Z', finger: 'pinky-l' },
                { key: 'x', label: 'X', finger: 'ring-l' },
                { key: 'c', label: 'C', finger: 'middle-l' },
                { key: 'v', label: 'V', finger: 'index-l' },
                { key: 'b', label: 'B', finger: 'index-l' },
                { key: 'n', label: 'N', finger: 'index-r' },
                { key: 'm', label: 'M', finger: 'index-r' },
                { key: ',', label: ',', finger: 'middle-r' },
                { key: '.', label: '.', finger: 'ring-r' },
                { key: '/', label: '/', finger: 'pinky-r' },
                { key: 'ShiftRight', label: 'Shift', finger: 'pinky-r', width: 'w-16 sm:w-24' }
            ],
            [
                { key: ' ', label: 'SPASI (Jempol)', finger: 'thumb', width: 'w-64 sm:w-96' }
            ]
        ];

        // Deskripsi Nama Jari & Warna Indikator
        const FINGER_INFO = {
            'pinky-l':  { name: 'Kelingking Kiri', color: '#6366f1' },
            'ring-l':   { name: 'Jari Manis Kiri', color: '#0ea5e9' },
            'middle-l': { name: 'Jari Tengah Kiri', color: '#06b6d4' },
            'index-l':  { name: 'Telunjuk Kiri', color: '#2563eb' },
            'thumb':    { name: 'Jempol (Ibu Jari)', color: '#38bdf8' },
            'index-r':  { name: 'Telunjuk Kanan', color: '#3b82f6' },
            'middle-r': { name: 'Jari Tengah Kanan', color: '#0284c7' },
            'ring-r':   { name: 'Jari Manis Kanan', color: '#38bdf8' },
            'pinky-r':  { name: 'Kelingking Kanan', color: '#818cf8' }
        };

        // Peta cepat karakter -> info jari
        const CHAR_TO_FINGER = {};
        KEYBOARD_LAYOUT.forEach(row => {
            row.forEach(item => {
                CHAR_TO_FINGER[item.key.toLowerCase()] = item.finger;
            });
        });

        /**
         * STATE APLIKASI
         */
        let currentLevel = 2;
        let selectedDuration = 60; // detik (0 = tanpa batas)
        let timeLeft = 60;
        let timeElapsed = 0;
        let timerInterval = null;
        let isRunning = false;
        let isFinished = false;

        let targetText = "";
        let currentIndex = 0;
        let totalTyped = 0;
        let errorCount = 0;
        let charStates = []; // 'pending' | 'correct' | 'incorrect'

        /**
         * ELEMEN DOM
         */
        const levelSelect = document.getElementById('level-select');
        const timeSelect = document.getElementById('time-select');
        const textDisplay = document.getElementById('text-display');
        const hiddenInput = document.getElementById('hidden-input');
        const focusOverlay = document.getElementById('focus-overlay');
        const virtualKeyboard = document.getElementById('virtual-keyboard');

        const statWpm = document.getElementById('stat-wpm');
        const statAccuracy = document.getElementById('stat-accuracy');
        const statTime = document.getElementById('stat-time');
        const statTimeUnit = document.getElementById('stat-time-unit');
        const statusBadge = document.getElementById('status-badge');
        const progressText = document.getElementById('progress-text');

        const nextKeyBadge = document.getElementById('next-key-badge');
        const fingerNameText = document.getElementById('finger-name-text');
        const fingerColorDot = document.getElementById('finger-color-dot');

        const btnReset = document.getElementById('btn-reset');
        const resultModal = document.getElementById('result-modal');
        const btnPlayAgain = document.getElementById('btn-play-again');

        /**
         * INISIALISASI KEYBOARD VIRTUAL
         */
        function renderVirtualKeyboard() {
            virtualKeyboard.innerHTML = '';

            KEYBOARD_LAYOUT.forEach(row => {
                const rowDiv = document.createElement('div');
                rowDiv.className = 'flex justify-center gap-1 sm:gap-1.5';

                row.forEach(keyObj => {
                    const keyEl = document.createElement('div');
                    const widthClass = keyObj.width || 'w-7 sm:w-11';
                    
                    keyEl.className = `key-cap finger-${keyObj.finger} ${widthClass} h-9 sm:h-11 bg-slate-50 border border-slate-300 rounded-lg flex flex-col items-center justify-center text-xs sm:text-sm font-semibold text-navy-900 relative`;
                    keyEl.dataset.key = keyObj.key.toLowerCase();
                    keyEl.textContent = keyObj.label;

                    // Tambahkan garis tonjolan taktil (tactile bump) pada huruf F dan J
                    if (keyObj.bump) {
                        const bump = document.createElement('span');
                        bump.className = 'w-3 h-0.5 bg-blue-600 rounded-full mt-0.5';
                        keyEl.appendChild(bump);
                    }

                    rowDiv.appendChild(keyEl);
                });

                virtualKeyboard.appendChild(rowDiv);
            });
        }

        /**
         * MENGAMBIL TEKS LATIHAN SECARA ACAK SESUAI LEVEL
         */
        function generatePracticeText(level) {
            const list = PRACTICE_TEXTS[level] || PRACTICE_TEXTS[2];
            // Gabungkan 2 kalimat/baris acak agar teks cukup panjang untuk durasi 60 detik
            const shuffled = [...list].sort(() => Math.random() - 0.5);
            return shuffled.slice(0, 2).join(' ');
        }

        /**
         * MERENDER TEKS LATIHAN KE LAYAR
         */
        function renderText() {
            textDisplay.innerHTML = '';
            targetText.split('').forEach((char, idx) => {
                const span = document.createElement('span');
                span.textContent = char;
                span.id = `char-${idx}`;
                
                if (idx === currentIndex) {
                    span.className = 'char-active';
                } else if (charStates[idx] === 'correct') {
                    span.className = 'char-correct';
                } else if (charStates[idx] === 'incorrect') {
                    span.className = 'char-incorrect';
                }

                textDisplay.appendChild(span);
            });

            updateKeyboardGuide();
            updateProgress();
        }

        /**
         * MEMPERBARUI SOROTAN TOMBOL VIRTUAL & PANDUAN JARI
         */
        function updateKeyboardGuide() {
            // Hapus sorotan tombol target sebelumnya
            document.querySelectorAll('.key-target').forEach(el => {
                el.classList.remove('key-target');
            });

            if (currentIndex >= targetText.length) return;

            const nextChar = targetText[currentIndex];
            const lowerChar = nextChar.toLowerCase();

            // Tampilkan label tombol berikutnya
            if (nextChar === ' ') {
                nextKeyBadge.textContent = 'SPASI';
            } else if (nextChar !== lowerChar && /[A-Z]/.test(nextChar)) {
                nextKeyBadge.textContent = `Shift + ${nextChar}`;
            } else {
                nextKeyBadge.textContent = nextChar.toUpperCase();
            }

            // Highlight tombol di keyboard virtual
            const targetKeyEl = document.querySelector(`.key-cap[data-key="${CSS.escape(lowerChar)}"]`);
            if (targetKeyEl) {
                targetKeyEl.classList.add('key-target');
            }

            // Highlight tombol Shift jika huruf kapital
            if (nextChar !== lowerChar && /[A-Z]/.test(nextChar)) {
                const fingerForChar = CHAR_TO_FINGER[lowerChar] || '';
                // Gunakan Shift berlawanan tangan
                const shiftKey = fingerForChar.endsWith('-l') ? 'shiftright' : 'shiftleft';
                const shiftEl = document.querySelector(`.key-cap[data-key="${shiftKey}"]`);
                if (shiftEl) shiftEl.classList.add('key-target');
            }

            // Perbarui teks & warna panduan jari
            const fingerCode = CHAR_TO_FINGER[lowerChar] || 'index-r';
            const info = FINGER_INFO[fingerCode];
            if (info) {
                fingerNameText.textContent = info.name;
                fingerColorDot.style.backgroundColor = info.color;
            }
        }

        /**
         * MEMPERBARUI STATISTIK WPM & AKURASI REAL-TIME
         */
        function updateStats() {
            // Hitung WPM: (Jumlah karakter benar / 5) / (Waktu berlalu dalam menit)
            const correctChars = charStates.filter(s => s === 'correct').length;
            const minutes = timeElapsed / 60;
            const wpm = minutes > 0 ? Math.round((correctChars / 5) / minutes) : 0;
            statWpm.textContent = wpm;

            // Hitung Akurasi
            const accuracy = totalTyped > 0 
                ? Math.max(0, Math.round(((totalTyped - errorCount) / totalTyped) * 100)) 
                : 100;
            statAccuracy.textContent = accuracy;
        }

        function updateProgress() {
            const pct = targetText.length > 0 ? Math.round((currentIndex / targetText.length) * 100) : 0;
            progressText.textContent = `${pct}%`;
        }

        /**
         * MEMULAI TIMER
         */
        function startTimer() {
            if (isRunning) return;
            isRunning = true;

            statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Sedang Berlangsung`;
            statusBadge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700";

            timerInterval = setInterval(() => {
                timeElapsed++;

                if (selectedDuration > 0) {
                    timeLeft--;
                    statTime.textContent = timeLeft;

                    if (timeLeft <= 10) {
                        statTime.classList.add('text-rose-600');
                    }

                    if (timeLeft <= 0) {
                        finishSession();
                    }
                } else {
                    // Mode Tanpa Batas: hitung maju
                    statTime.textContent = timeElapsed;
                }

                updateStats();
            }, 1000);
        }

        /**
         * MENGAKHIRI SESI & MENAMPILKAN MODAL HASIL
         */
        function finishSession() {
            clearInterval(timerInterval);
            isRunning = false;
            isFinished = true;
            hiddenInput.blur();

            // Pastikan minimal waktu 1 detik agar WPM tidak Infinity
            const effectiveSeconds = Math.max(1, timeElapsed);
            const correctChars = charStates.filter(s => s === 'correct').length;
            const finalWpm = Math.round((correctChars / 5) / (effectiveSeconds / 60));
            const finalAccuracy = totalTyped > 0 
                ? Math.max(0, Math.round(((totalTyped - errorCount) / totalTyped) * 100)) 
                : 100;

            // Tentukan Predikat Kecepatan (Standar Pelajar SMA)
            let rank = "Pemula Semangat";
            let feedback = "Bagus! Terus biasakan jari-jarimu berada di posisi dasar (ASDF - JKL;) dan utamakan ketepatan sebelum kecepatan.";

            if (finalWpm >= 55 && finalAccuracy >= 95) {
                rank = "Ahli 10 Jari (Master)";
                feedback = "Luar biasa! Kecepatan dan akurasimu setara pengetik profesional. Pertahankan konsistensi ini!";
            } else if (finalWpm >= 35 && finalAccuracy >= 90) {
                rank = "Pelajar Terampil";
                feedback = "Hebat! Kecepatan mengetikmu sudah di atas rata-rata pelajar SMA. Sedikit lagi menuju level Ahli!";
            } else if (finalWpm >= 20) {
                rank = "Pelajar Berkembang";
                feedback = "Perkembangan yang baik! Coba kurangi melihat ke arah keyboard agar reflek jari semakin cepat.";
            }

            // Isi data ke Modal
            document.getElementById('result-wpm').textContent = finalWpm;
            document.getElementById('result-accuracy').textContent = `${finalAccuracy}%`;
            document.getElementById('result-errors').textContent = errorCount;
            document.getElementById('result-rank').textContent = rank;
            document.getElementById('result-feedback').textContent = feedback;

            // Tampilkan Modal
            resultModal.classList.remove('hidden');
        }

        /**
         * MERESET / MEMULAI ULANG LATIHAN
         */
        function resetSession() {
            clearInterval(timerInterval);
            isRunning = false;
            isFinished = false;
            currentIndex = 0;
            totalTyped = 0;
            errorCount = 0;
            timeElapsed = 0;

            currentLevel = parseInt(levelSelect.value, 10);
            selectedDuration = parseInt(timeSelect.value, 10);
            timeLeft = selectedDuration;

            // Update tampilan waktu awal
            statTime.classList.remove('text-rose-600');
            if (selectedDuration > 0) {
                statTime.textContent = selectedDuration;
                statTimeUnit.textContent = 'detik';
            } else {
                statTime.textContent = '0';
                statTimeUnit.textContent = 'dtk (∞)';
            }

            statWpm.textContent = '0';
            statAccuracy.textContent = '100';

            statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span> Siap Mengetik`;
            statusBadge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700";

            targetText = generatePracticeText(currentLevel);
            charStates = new Array(targetText.length).fill('pending');

            resultModal.classList.add('hidden');
            focusOverlay.classList.add('hidden');
            hiddenInput.value = '';
            
            renderText();
            setTimeout(() => hiddenInput.focus(), 50);
        }

        /**
         * PENANGANAN INPUT KETIKAN PENGGUNA
         */
        hiddenInput.addEventListener('keydown', (e) => {
            if (isFinished) return;

            // Visual efek tekan pada keyboard virtual
            const pressedKey = e.key.toLowerCase();
            const keyEl = document.querySelector(`.key-cap[data-key="${CSS.escape(pressedKey)}"]`);
            if (keyEl) {
                keyEl.classList.add('key-pressed');
            }

            // Abaikan tombol pengubah (Shift, Ctrl, Alt, CapsLock, Tab)
            if (['Shift', 'Control', 'Alt', 'Meta', 'CapsLock', 'Tab', 'Escape'].includes(e.key)) {
                return;
            }

            // Penanganan Backspace (koreksi huruf sebelumnya)
            if (e.key === 'Backspace') {
                e.preventDefault();
                if (currentIndex > 0) {
                    const prevSpan = document.getElementById(`char-${currentIndex}`);
                    if (prevSpan) prevSpan.className = '';

                    currentIndex--;
                    charStates[currentIndex] = 'pending';

                    const currSpan = document.getElementById(`char-${currentIndex}`);
                    if (currSpan) currSpan.className = 'char-active';

                    updateKeyboardGuide();
                    updateProgress();
                }
                return;
            }

            // Hanya proses karakter tunggal yang dapat dicetak
            if (e.key.length === 1) {
                e.preventDefault();

                // Mulai timer otomatis pada ketikan pertama
                if (!isRunning) {
                    startTimer();
                }

                const expectedChar = targetText[currentIndex];
                const typedChar = e.key;
                const currentSpan = document.getElementById(`char-${currentIndex}`);

                totalTyped++;

                if (typedChar === expectedChar) {
                    charStates[currentIndex] = 'correct';
                    if (currentSpan) currentSpan.className = 'char-correct';
                } else {
                    charStates[currentIndex] = 'incorrect';
                    errorCount++;
                    if (currentSpan) currentSpan.className = 'char-incorrect';
                }

                currentIndex++;

                // Cek apakah seluruh teks sudah selesai diketik
                if (currentIndex >= targetText.length) {
                    updateStats();
                    updateProgress();
                    finishSession();
                    return;
                }

                // Pindahkan sorotan aktif ke huruf berikutnya & auto-scroll jika perlu
                const nextSpan = document.getElementById(`char-${currentIndex}`);
                if (nextSpan) {
                    nextSpan.className = 'char-active';
                    nextSpan.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }

                updateStats();
                updateKeyboardGuide();
                updateProgress();
            }
        });

        // Lepas efek tekan tombol virtual saat tombol fisik dilepas
        document.addEventListener('keyup', (e) => {
            const releasedKey = e.key.toLowerCase();
            const keyEl = document.querySelector(`.key-cap[data-key="${CSS.escape(releasedKey)}"]`);
            if (keyEl) {
                keyEl.classList.remove('key-pressed');
            }
            // Pastikan semua efek tekan terhapus jika tombol Shift/dll dilepas
            if (e.key === 'Shift') {
                document.querySelectorAll('.key-pressed').forEach(el => el.classList.remove('key-pressed'));
            }
        });

        // Manajemen Fokus Otomatis
        hiddenInput.addEventListener('blur', () => {
            if (!isFinished) {
                focusOverlay.classList.remove('hidden');
            }
        });

        hiddenInput.addEventListener('focus', () => {
            focusOverlay.classList.add('hidden');
        });

        focusOverlay.addEventListener('click', () => {
            hiddenInput.focus();
        });

        // Event Listeners Kontrol & Tombol
        levelSelect.addEventListener('change', resetSession);
        timeSelect.addEventListener('change', resetSession);
        btnReset.addEventListener('click', resetSession);
        btnPlayAgain.addEventListener('click', resetSession);

        // Inisialisasi saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            renderVirtualKeyboard();
            resetSession();
        });
    </script>
</body>
</html>
