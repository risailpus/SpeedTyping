    <style>
        /* Kustomisasi Scrollbar & Animasi Halus */
        body {
            background-color: #f1f5f9;
            color: #0f172a;
            overflow-x: hidden;
        }

        /* Animasi Kursor Berkedip pada Huruf Aktif */
        @keyframes pulseCaret {
            0%, 100% { border-bottom-color: #2563eb; background-color: #dbeafe; }
            50% { border-bottom-color: transparent; background-color: #eff6ff; }
        }

        .char-active {
            border-bottom: 3px solid #2563eb;
            background-color: #dbeafe;
            color: #1e3a8a;
            border-radius: 3px;
            animation: pulseCaret 1.1s infinite;
        }

        .char-correct {
            color: #059669; /* Hijau lembut */
        }

        .char-incorrect {
            color: #dc2626; /* Merah lembut */
            background-color: #fee2e2;
            border-radius: 3px;
            text-decoration: underline wavy #ef4444;
        }

        /* Styling Keyboard Virtual */
        .key-cap {
            transition: all 0.08s ease;
            user-select: none;
            box-shadow: 0 3px 0 #cbd5e1;
        }

        /* Tombol yang menjadi target berikutnya */
        .key-target {
            background-color: #2563eb !important;
            color: #ffffff !important;
            border-color: #1d4ed8 !important;
            box-shadow: 0 3px 0 #1e3a8a, 0 0 12px rgba(37, 99, 235, 0.5) !important;
            transform: translateY(-1px);
            font-weight: 700;
        }

        /* Efek saat tombol fisik ditekan */
        .key-pressed {
            transform: translateY(3px) !important;
            box-shadow: 0 0px 0 #94a3b8 !important;
            background-color: #0f172a !important;
            color: #ffffff !important;
        }

        /* Warna Panduan Jari pada Border Bawah Keycap (Halus & Selaras Tema Biru/Slate) */
        .finger-pinky-l   { border-bottom: 3px solid #6366f1; } /* Indigo */
        .finger-ring-l    { border-bottom: 3px solid #0ea5e9; } /* Sky Blue */
        .finger-middle-l  { border-bottom: 3px solid #06b6d4; } /* Cyan */
        .finger-index-l   { border-bottom: 3px solid #2563eb; } /* Royal Blue */
        .finger-thumb     { border-bottom: 3px solid #1e3a8a; } /* Navy */
        .finger-index-r   { border-bottom: 3px solid #3b82f6; } /* Blue */
        .finger-middle-r  { border-bottom: 3px solid #0284c7; } /* Deep Sky */
        .finger-ring-r    { border-bottom: 3px solid #38bdf8; } /* Light Sky */
        .finger-pinky-r   { border-bottom: 3px solid #818cf8; } /* Soft Indigo */
    </style>
</head>
